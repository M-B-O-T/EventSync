generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}


model Event {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  location    String
  startDate   DateTime
  endDate     DateTime

  sessions    Session[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model Room {
  id       Int       @id @default(autoincrement())
  name     String    @unique

  sessions Session[]
}


model Speaker {
  id          Int       @id @default(autoincrement())
  fullName    String
  photoUrl    String?
  bio         String?
  socialLinks Json?

  sessions    SessionSpeaker[]

  createdAt   DateTime @default(now())
}


model Session {
  id          Int      @id @default(autoincrement())
  title       String
  description String?

  startTime   DateTime
  endTime     DateTime

  capacity    Int?

  eventId     Int
  roomId      Int

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id])

  speakers    SessionSpeaker[]
  questions   Question[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model SessionSpeaker {
  sessionId Int
  speakerId Int

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker   Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
}

model Question {
  id          Int      @id @default(autoincrement())
  content     String
  authorName  String?
  upvotes     Int      @default(0)

  sessionId   Int
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  // relation future (optionnel)
  votes       QuestionVote[]
}


model QuestionVote {
  id          Int      @id @default(autoincrement())

  questionId  Int
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userId      String?  // futur participant authentifié
  createdAt   DateTime @default(now())
}